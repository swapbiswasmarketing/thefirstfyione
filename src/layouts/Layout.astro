---
import "../styles/global.css";
import {
  cats,
  gtmId,
  consentDefaults,
  consentRegions,
  deptHref,
  fmtDay,
  fmtDate,
  newsletterLive,
  adsenseClient,
  adsenseLive,
  adsServing,
  consentMessage,
  SITE_URL,
  SITE_NAME,
  SITE_DESCRIPTION,
} from "../data/site";
import { getEntries, edition } from "../lib/entries";
import { jsonLd } from "../lib/schema";
import { pageCard, type Card } from "../lib/og";

interface Props {
  title?: string;
  description?: string;
  /* Social card for og:image and twitter:image. Defaults to the front-page card. */
  card?: Card;
  type?: "website" | "article";
  publishedTime?: string;
  modifiedTime?: string;
  section?: string;
  /* The homepage carries its own masthead (slot="masthead"), so it suppresses the running head. */
  bare?: boolean;
  /* Page measure. Set narrower on reading pages so the running head, the text
     block and the colophon all share one left and right edge. */
  wrap?: string;
  /* noindex,follow; also drops the canonical. Pair with a sitemap filter entry. */
  noindex?: boolean;
  /* Page-level JSON-LD nodes. WebSite and Organization are always added. */
  schema?: Record<string, unknown>[];
  /* GA4 content group and entry id, pushed to the dataLayer before GTM loads. */
  contentGroup?: string;
  entryId?: string;
  /* Auto ads may run on this page. Off for pages without publisher content
     (404, search, privacy), which AdSense policy keeps ads away from. */
  ads?: boolean;
}

const {
  title = "Strictly FYI - interesting things, strictly for your information",
  description = SITE_DESCRIPTION,
  card = pageCard("home"),
  type = "website",
  publishedTime,
  modifiedTime,
  section,
  bare = false,
  wrap,
  noindex = false,
  schema = [],
  contentGroup,
  entryId,
  ads = true,
} = Astro.props;
const adsOn = adsenseLive && adsServing && ads;
/* AdSense serves ads to readers in the EEA, the UK and Switzerland only through a
   Google-certified consent message; turning ads on without it would break both
   the policy and the privacy page. Publish the message in AdSense first. */
if (adsenseLive && adsServing && !consentMessage) {
  throw new Error("src/data/site.ts: adsServing = true needs consentMessage = true (publish Google's European regulations message in AdSense > Privacy & messaging first)");
}

const site = new URL(SITE_URL);
const path = Astro.url.pathname;
const canonical = new URL(path, site).href;
const ogImage = new URL(card.url, site).href;
const year = new Date().getFullYear();

/* The dateline comes from the archive, not the build clock: a static page that
   prints "today" is only right on the day it was deployed. */
const ed = edition(await getEntries());

const nav = [
  { href: "/blog/", label: "Read" },
  { href: "/topics/", label: "Topics" },
  { href: "/search/", label: "Search" },
  { href: "/about/", label: "About" },
];
const navState = (href: string) => (path === href ? "page" : path.startsWith(href) ? "true" : undefined);

const group =
  contentGroup ??
  (path === "/" ? "Front page" : path === "/blog/" ? "Archive" : path.startsWith("/topics/") ? "Topics" : "Other");

/* Google Tag Manager loader. Kept as one inline string so the container ID
   stays in src/data/site.ts and never gets duplicated across the head and the
   noscript fallback below. */
const gtmSnippet = gtmId
  ? `(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','${gtmId}');`
  : "";

/* Runs before the container: the region-scoped consent default (a dataLayer
   command, not a tag), then the page metadata GA4 reads as a content group. */
const preGtm = gtmId
  ? [
      "window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}",
      consentDefaults
        ? `gtag('consent','default',{ad_storage:'denied',ad_user_data:'denied',ad_personalization:'denied',analytics_storage:'denied',${consentMessage ? "wait_for_update:500," : ""}region:${JSON.stringify(consentRegions)}});`
        : "",
      `dataLayer.push(${JSON.stringify({ content_group: group, entry_id: entryId ?? "" }).replace(/</g, "\\u003c")});`,
    ].join("")
  : "";

const gtmNoscript = gtmId
  ? `<iframe src="https://www.googletagmanager.com/ns.html?id=${gtmId}" height="0" width="0" style="display:none;visibility:hidden"></iframe>`
  : "";

/* Next-page prefetch with no script: when a reader hovers or presses a link to
   another page on this site, Chromium fetches that page's HTML ahead of the
   click (eagerness "moderate"). Prefetch only, never prerender, so GTM never
   runs for a page nobody opened. Feeds, text files and Pagefind assets are left
   out, and any link can opt out with data-no-prefetch. Other browsers ignore it. */
const speculationRules = JSON.stringify({
  prefetch: [
    {
      source: "document",
      where: {
        and: [
          { href_matches: "/*" },
          { not: { href_matches: "/*.xml" } },
          { not: { href_matches: "/*.txt" } },
          { not: { href_matches: "/pagefind/*" } },
          { not: { selector_matches: "[data-no-prefetch]" } },
        ],
      },
      eagerness: "moderate",
    },
  ],
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    {gtmId && (
      <>
        <link rel="preconnect" href="https://www.googletagmanager.com" />
        <script is:inline set:html={preGtm} />
        <script is:inline set:html={gtmSnippet} />
      </>
    )}
    {adsenseLive && <meta name="google-adsense-account" content={adsenseClient} />}
    {adsOn && (
      <script
        is:inline
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseClient}`}
        crossorigin="anonymous"
      ></script>
    )}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE_NAME} />
    {noindex ? (
      <meta name="robots" content="noindex, follow" />
    ) : (
      <>
        <meta name="robots" content="max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
        <link rel="canonical" href={canonical} />
      </>
    )}

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content={card.type} />
    <meta property="og:image:width" content={String(card.width)} />
    <meta property="og:image:height" content={String(card.height)} />
    <meta property="og:image:alt" content={card.alt} />
    {type === "article" && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {type === "article" && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {type === "article" && section && <meta property="article:section" content={section} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={card.alt} />

    <meta name="theme-color" content="#f6f3ec" />
    <link rel="alternate" type="application/rss+xml" title={SITE_NAME} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {/* Fonts are self-hosted from src/styles/global.css (@font-face), on purpose
        with no preconnect and no preload: see the note at the top of that file. */}

    <script is:inline type="speculationrules" set:html={speculationRules} />
    <script is:inline type="application/ld+json" set:html={jsonLd(schema)} />
  </head>
  <body style={wrap ? `--wrap: ${wrap}` : undefined}>
    {gtmId && <noscript set:html={gtmNoscript} />}
    <a class="skip" href="#main">Skip to content</a>

    <slot name="masthead" />

    {!bare && (
      <header class="runhead" data-no-auto-ads={adsOn ? "all" : undefined}>
        <div class="wrap">
          <div class="rh-top">
            <span>Strictly FYI &middot; Vol. {ed.vol}</span>
            <span class="rh-mid">A field guide to the fascinating</span>
            <span><span class="rh-long">Last filed {fmtDay(ed.latest)}</span><span class="rh-short">Filed {fmtDate(ed.latest)}</span></span>
          </div>
          <div class="rh-main">
            <a href="/" class="rh-name" aria-label="Strictly FYI home">Strictly <span class="rh-fyi">FYI</span></a>
            <nav class="rh-nav" aria-label="Primary">
              {nav.map((n) => (
                <a href={n.href} aria-current={navState(n.href)}>{n.label}</a>
              ))}
              <a href="/rss.xml" data-track="cta_click" data-track-cta-type="rss" data-track-cta-location="runhead">RSS</a>
              {newsletterLive && (
                <a href="/#subscribe" class="rh-cta" data-track="cta_click" data-track-cta-type="subscribe" data-track-cta-location="runhead">Subscribe</a>
              )}
            </nav>
          </div>
          <div class="rule-thickthin"></div>
        </div>
      </header>
    )}

    <main id="main">
      <slot />
    </main>

    <footer class="colophon cv-auto" data-no-auto-ads={adsOn ? "inside" : undefined}>
      <div class="wrap">
        <div class="colophon-top">
          <p class="imprint">
            <span class="imprint-name">Strictly FYI</span> is set in Playfair Display, Newsreader &amp; Space Mono.
            Composed in Astro. Printed on the web since MMXXVI.
            <br />Interesting things, strictly for your information.
          </p>
          <nav class="colophon-nav" aria-label="Footer">
            <a href="/blog/">Read</a> &middot; <a href="/topics/">Topics</a> &middot; <a href="/search/">Search</a> &middot;
            <a href="/about/">About</a> &middot; <a href="/how-we-work/">How we work</a> &middot;
            <a href="/corrections/">Corrections</a> &middot; <a href="/contact/">Contact</a> &middot;
            <a href="/privacy/">Privacy</a> &middot; <a href="/terms/">Terms</a> &middot; <a href="/rss.xml">RSS</a>
            {consentMessage && (
              <span data-consent-ui hidden>
                {" "}&middot; <button type="button" class="consent-link">Privacy and cookie settings</button>
              </span>
            )}
          </nav>
        </div>
        <div class="colophon-feet">
          <nav class="depts" aria-label="Footer departments">
            {cats.map((c, i) => (
              <>
                <a href={deptHref(c.key)}>&sect;{c.n} {c.name}</a>
                {i < cats.length - 1 && <span aria-hidden="true"> &middot; </span>}
              </>
            ))}
          </nav>
          <span>&copy; {year} Strictly FYI</span>
          <span class="end-mark" aria-hidden="true">END</span>
        </div>
      </div>
    </footer>

    <style>
      .skip {
        position: absolute; left: -999px; top: 0;
        background: var(--ink); color: var(--paper);
        padding: 0.7rem 1.1rem; z-index: var(--z-skip);
        font-family: var(--mono); font-size: 0.8rem;
      }
      .skip:focus { left: 0; }

      /* -------- RUNNING HEAD -------- */
      .runhead { padding-top: 1rem; }
      .rh-top {
        display: flex; justify-content: space-between; gap: 1rem;
        font-family: var(--mono); font-size: 0.63rem; letter-spacing: 0.13em;
        text-transform: uppercase; color: var(--ink-faint);
        border-bottom: 1px solid var(--ink); padding-bottom: 0.5rem;
      }
      .rh-mid { color: var(--ink-soft); }
      .rh-short { display: none; }

      .rh-main {
        display: flex; align-items: baseline; justify-content: space-between;
        gap: 1.25rem 2rem; flex-wrap: wrap; padding: 0.75rem 0 0.7rem;
      }
      /* The nameplate's box does not depend on which font has loaded: one line
         (nowrap, line-height 1) and a fixed width, 6.66em, which is "STRICTLY
         FYI" in Playfair Display 900 at this tracking (6.651em measured). A
         wider fallback paints into the 2rem gap instead of pushing the nav onto
         another line, so the swap cannot move the row. Re-measure if the text,
         the tracking or the .rh-fyi padding changes. */
      .rh-name {
        font-family: var(--display); font-weight: 900; text-transform: uppercase;
        font-size: clamp(1.45rem, 3.4vw, 2.1rem); line-height: 1; letter-spacing: -0.03em;
        text-decoration: none; color: var(--ink); white-space: nowrap;
        flex: none; inline-size: 6.66em;
      }
      .rh-fyi {
        background-image: linear-gradient(transparent 54%, var(--hl) 54%, var(--hl) 92%, transparent 92%);
        padding: 0 0.05em;
      }

      .rh-nav {
        display: flex; align-items: baseline; gap: 0.35rem 1.15rem; flex-wrap: wrap;
        font-family: var(--mono); font-size: 0.72rem; letter-spacing: 0.09em; text-transform: uppercase;
      }
      .rh-nav a {
        color: var(--ink-soft); text-decoration: none;
        padding-bottom: 2px; border-bottom: 1.5px solid transparent;
        transition: color var(--t-hover) var(--ease-out), border-color var(--t-hover) var(--ease-out);
      }
      .rh-nav a[aria-current] { color: var(--ink); border-bottom-color: var(--ink); }
      .rh-cta { color: var(--ink) !important; }

      @media (hover: hover) and (pointer: fine) {
        .rh-nav a:hover { color: var(--ink); border-bottom-color: var(--ink); }
        .rh-name:hover .rh-fyi { background-color: var(--hl-deep); }
      }

      @media (max-width: 640px) {
        .rh-mid { display: none; }
        .rh-top > span { white-space: nowrap; }
        .rh-long { display: none; }
        .rh-short { display: inline; }
        .rh-top { font-size: 0.58rem; letter-spacing: 0.1em; }
        .rh-main { padding-top: 0.65rem; gap: 0.6rem; }
        .rh-nav { gap: 0.3rem 0.9rem; font-size: 0.68rem; }
      }

      /* -------- COLOPHON -------- */
      .colophon {
        margin-top: clamp(3rem, 8vw, 5rem);
        border-top: 1px solid var(--ink);
        padding: 1.4rem 0 2.5rem;
        --cv-size: 11.25rem; /* measured 180px at 1280 */
      }
      .colophon-top { display: flex; justify-content: space-between; gap: 1.25rem 2rem; flex-wrap: wrap; }
      .imprint { font-family: var(--mono); font-size: 0.71rem; line-height: 1.75; color: var(--ink-faint); max-width: 36rem; }
      .imprint-name { color: var(--ink); }
      .colophon-nav { font-family: var(--mono); font-size: 0.72rem; color: var(--ink-faint); line-height: 1.9; }
      .consent-link {
        font: inherit; color: var(--ink-soft); background: none; border: none; padding: 0; cursor: pointer;
        transition: background var(--t-hover) var(--ease-out), color var(--t-hover) var(--ease-out);
      }
      @media (hover: hover) and (pointer: fine) {
        .consent-link:hover { background: var(--hl); color: var(--ink); }
      }
      .colophon-nav a, .depts a {
        color: var(--ink-soft); text-decoration: none;
        transition: background var(--t-hover) var(--ease-out), color var(--t-hover) var(--ease-out);
      }
      .colophon-feet {
        display: flex; justify-content: space-between; align-items: baseline; gap: 0.5rem 1.5rem; flex-wrap: wrap;
        margin-top: 1.5rem; padding-top: 0.8rem; border-top: 1px solid var(--rule);
        font-family: var(--mono); font-size: 0.6rem; letter-spacing: 0.09em; text-transform: uppercase;
        color: var(--ink-faint);
      }
      /* 2.6 keeps neighbouring links 24px apart on a phone (WCAG 2.5.8). */
      .depts { flex: 1 1 auto; min-width: 0; line-height: 2.6; }
      .depts a { color: var(--ink-faint); }
      .end-mark { color: var(--ink); }

      @media (hover: hover) and (pointer: fine) {
        .colophon-nav a:hover, .depts a:hover { background: var(--hl); color: var(--ink); }
      }
      @media (max-width: 720px) {
        .colophon { --cv-size: 22.5rem; /* about 360px at 390 with the taller nav rows */ }
        .colophon-feet { flex-direction: column; align-items: flex-start; gap: 0.45rem; }
        /* Ten links wrap onto several rows on a phone: 2.6 keeps rows 24px apart (WCAG 2.5.8), as .depts does. */
        .colophon-nav { line-height: 2.6; }
      }
    </style>

    <script>
      import { track } from "../lib/track";

      /* One delegated listener for every tracked click on the site. Markup opts in:
         data-track="event_name" plus data-track-* parameters, e.g.
         data-track-cta-location="runhead" arrives in the dataLayer as
         { event: "event_name", cta_location: "runhead" }. Capture phase, so a
         handler that stops propagation cannot swallow the event. */
      const snake = (k: string) => k.replace(/[A-Z]/g, (c) => "_" + c.toLowerCase());
      document.addEventListener(
        "click",
        (e) => {
          const el = (e.target as Element | null)?.closest?.("[data-track]") as HTMLElement | null;
          if (!el || !el.dataset.track) return;
          const params: Record<string, string> = {};
          for (const [k, v] of Object.entries(el.dataset)) {
            if (k.startsWith("track") && k.length > 5 && v) params[snake(k[5].toLowerCase() + k.slice(6))] = v;
          }
          track(el.dataset.track, params);
        },
        { capture: true }
      );

      /* "Privacy and cookie settings" reopens Google's consent message (the
         certified CMP that AdSense loads for the EEA, the UK and Switzerland).
         It appears only where that message applies, once its API is ready, so
         nobody elsewhere sees a control that does nothing. */
      const consentUi = document.querySelector<HTMLElement>("[data-consent-ui]");
      if (consentUi) {
        type Fc = { callbackQueue?: object[]; showRevocationMessage?: () => void };
        type Tcf = (cmd: string, v: number, cb: (data: { gdprApplies?: boolean } | null, ok: boolean) => void) => void;
        const w = window as unknown as { googlefc?: Fc; __tcfapi?: Tcf };
        w.googlefc = w.googlefc || {};
        (w.googlefc.callbackQueue = w.googlefc.callbackQueue || []).push({
          CONSENT_DATA_READY: () =>
            w.__tcfapi?.("getTCData", 2, (data, ok) => {
              if (ok && data?.gdprApplies) consentUi.hidden = false;
            }),
        });
        consentUi.querySelector("button")?.addEventListener("click", () => w.googlefc?.showRevocationMessage?.());
      }
    </script>
  </body>
</html>
