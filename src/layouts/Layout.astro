---
import "../styles/global.css";
import { cats, gtmId } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  publishedTime?: string;
  modifiedTime?: string;
  section?: string;
  /* The homepage carries its own full masthead, so it suppresses the running head. */
  bare?: boolean;
  /* Page measure. Set narrower on reading pages so the running head, the text
     block and the colophon all share one left and right edge. */
  wrap?: string;
}

const {
  title = "Strictly FYI - interesting things, strictly for your information",
  description = "A general-interest field guide to the fascinating - science, history, tech, culture, and everyday curiosities worth knowing. Strictly for your information.",
  image = "/og.png",
  type = "website",
  publishedTime,
  modifiedTime,
  section,
  bare = false,
  wrap,
} = Astro.props;

const site = Astro.site ?? new URL("https://strictly.fyi");
const canonical = new URL(Astro.url.pathname, site);
const ogImage = new URL(image, site);
const year = new Date().getFullYear();

const nav = [
  { href: "/blog/", label: "Read" },
  { href: "/#index", label: "Topics" },
  { href: "/about/", label: "About" },
];
const current = Astro.url.pathname;

const dateline = new Date()
  .toLocaleDateString("en-US", { weekday: "long", month: "long", day: "numeric", year: "numeric" })
  .toUpperCase();

/* Google Tag Manager loader. Kept as one inline string so the container ID
   stays in src/data/site.ts and never gets duplicated across the head and the
   noscript fallback below. */
const gtmSnippet = gtmId
  ? `(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','${gtmId}');`
  : "";

const gtmNoscript = gtmId
  ? `<iframe src="https://www.googletagmanager.com/ns.html?id=${gtmId}" height="0" width="0" style="display:none;visibility:hidden"></iframe>`
  : "";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Strictly FYI",
  url: site.href,
  description,
  publisher: {
    "@type": "Organization",
    name: "Strictly FYI",
    logo: { "@type": "ImageObject", url: new URL("/og.png", site).href },
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Google Tag Manager. GA4 and Clarity live as tags inside the container. -->
    {gtmId && (
      <>
        <link rel="preconnect" href="https://www.googletagmanager.com" />
        <script is:inline set:html={gtmSnippet} />
      </>
    )}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Strictly FYI" />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Strictly FYI" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Strictly FYI - interesting things worth knowing" />
    {type === "article" && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {type === "article" && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {type === "article" && section && <meta property="article:section" content={section} />}
    {type === "article" && <meta property="article:author" content="Strictly FYI" />}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Strictly FYI" />

    <meta name="theme-color" content="#f6f3ec" />
    <link rel="alternate" type="application/rss+xml" title="Strictly FYI" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400;1,6..72,500&family=Playfair+Display:ital,wght@0,600;0,700;0,900;1,600;1,700&family=Space+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body style={wrap ? `--wrap: ${wrap}` : undefined}>
    {gtmId && <noscript set:html={gtmNoscript} />}
    <a class="skip" href="#main">Skip to content</a>

    {!bare && (
      <header class="runhead">
        <div class="wrap">
          <div class="rh-top">
            <span>Strictly FYI · Vol. I</span>
            <span class="rh-mid">A field guide to the fascinating</span>
            <span>{dateline}</span>
          </div>
          <div class="rh-main">
            <a href="/" class="rh-name" aria-label="Strictly FYI home">Strictly <span class="rh-fyi">FYI</span></a>
            <nav class="rh-nav" aria-label="Primary">
              {nav.map((n) => (
                <a href={n.href} aria-current={current === n.href ? "page" : undefined}>{n.label}</a>
              ))}
              <a href="/rss.xml">RSS</a>
              <a href="/#subscribe" class="rh-cta">Subscribe →</a>
            </nav>
          </div>
          <div class="rule-thickthin"></div>
        </div>
      </header>
    )}

    <main id="main">
      <slot />
    </main>

    <footer class="colophon">
      <div class="wrap">
        <div class="colophon-top">
          <p class="imprint">
            <span class="imprint-name">Strictly FYI</span> is set in Playfair Display, Newsreader &amp; Space Mono.
            Composed in Astro. Printed on the web, Nº 001 · Est. MMXXVI.
            <br />Interesting things, strictly for your information.
          </p>
          <nav class="colophon-nav" aria-label="Footer">
            <a href="/blog/">Read</a> · <a href="/#index">Topics</a> · <a href="/about/">About</a> ·
            <a href="/rss.xml">RSS</a> · <a href="mailto:hello@strictly.fyi">Contact</a>
          </nav>
        </div>
        <div class="colophon-feet">
          <span class="depts">{cats.map((c) => `§${c.n} ${c.name}`).join("  ·  ")}</span>
          <span>© {year} Strictly FYI</span>
          <span class="end-mark">END</span>
        </div>
      </div>
    </footer>

    <style>
      .skip {
        position: absolute; left: -999px; top: 0;
        background: var(--ink); color: var(--paper);
        padding: 0.7rem 1.1rem; z-index: var(--z-skip);
        font-family: var(--mono); font-size: 0.8rem;
      }
      .skip:focus { left: 0; }

      /* -------- RUNNING HEAD -------- */
      .runhead { padding-top: 1rem; }
      .rh-top {
        display: flex; justify-content: space-between; gap: 1rem;
        font-family: var(--mono); font-size: 0.63rem; letter-spacing: 0.13em;
        text-transform: uppercase; color: var(--ink-faint);
        border-bottom: 1px solid var(--ink); padding-bottom: 0.5rem;
      }
      .rh-mid { color: var(--ink-soft); }

      .rh-main {
        display: flex; align-items: baseline; justify-content: space-between;
        gap: 1.25rem 2rem; flex-wrap: wrap; padding: 0.75rem 0 0.7rem;
      }
      .rh-name {
        font-family: var(--display); font-weight: 900; text-transform: uppercase;
        font-size: clamp(1.45rem, 3.4vw, 2.1rem); line-height: 1; letter-spacing: -0.03em;
        text-decoration: none; color: var(--ink); white-space: nowrap;
      }
      .rh-fyi {
        background-image: linear-gradient(transparent 54%, var(--hl) 54%, var(--hl) 92%, transparent 92%);
        padding: 0 0.05em;
      }

      .rh-nav {
        display: flex; align-items: baseline; gap: 0.35rem 1.15rem; flex-wrap: wrap;
        font-family: var(--mono); font-size: 0.72rem; letter-spacing: 0.09em; text-transform: uppercase;
      }
      .rh-nav a {
        color: var(--ink-soft); text-decoration: none;
        padding-bottom: 2px; border-bottom: 1.5px solid transparent;
        transition: color var(--t-hover) var(--ease-out), border-color var(--t-hover) var(--ease-out);
      }
      .rh-nav a[aria-current="page"] { color: var(--ink); border-bottom-color: var(--ink); }
      .rh-cta { color: var(--ink) !important; }

      @media (hover: hover) and (pointer: fine) {
        .rh-nav a:hover { color: var(--ink); border-bottom-color: var(--ink); }
        .rh-cta:hover { background: var(--hl); border-bottom-color: transparent !important; }
        .rh-name:hover .rh-fyi { background-color: var(--hl-deep); }
      }

      @media (max-width: 640px) {
        .rh-mid { display: none; }
        .rh-top { font-size: 0.58rem; letter-spacing: 0.1em; }
        .rh-main { padding-top: 0.65rem; gap: 0.6rem; }
        .rh-nav { gap: 0.3rem 0.9rem; font-size: 0.68rem; }
      }

      /* -------- COLOPHON -------- */
      .colophon {
        margin-top: clamp(3rem, 8vw, 5rem);
        border-top: 1px solid var(--ink);
        padding: 1.4rem 0 2.5rem;
      }
      .colophon-top { display: flex; justify-content: space-between; gap: 1.25rem 2rem; flex-wrap: wrap; }
      .imprint { font-family: var(--mono); font-size: 0.71rem; line-height: 1.75; color: var(--ink-faint); max-width: 58ch; }
      .imprint-name { color: var(--ink); }
      .colophon-nav { font-family: var(--mono); font-size: 0.72rem; color: var(--ink-faint); line-height: 1.9; }
      .colophon-nav a {
        color: var(--ink-soft); text-decoration: none;
        transition: background var(--t-hover) var(--ease-out), color var(--t-hover) var(--ease-out);
      }
      .colophon-feet {
        display: flex; justify-content: space-between; align-items: baseline; gap: 0.5rem 1.5rem; flex-wrap: wrap;
        margin-top: 1.5rem; padding-top: 0.8rem; border-top: 1px solid var(--rule);
        font-family: var(--mono); font-size: 0.6rem; letter-spacing: 0.09em; text-transform: uppercase;
        color: var(--ink-faint);
      }
      .depts { flex: 1 1 auto; min-width: 0; }
      .end-mark { color: var(--ink); }

      @media (hover: hover) and (pointer: fine) {
        .colophon-nav a:hover { background: var(--hl); color: var(--ink); }
      }
      @media (max-width: 720px) {
        .colophon-feet { flex-direction: column; align-items: flex-start; gap: 0.45rem; }
      }
    </style>

  </body>
</html>
