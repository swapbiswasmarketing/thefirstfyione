---
import Layout from "../../layouts/Layout.astro";
import LedgerRow from "../../components/LedgerRow.astro";
import SubscribeForm from "../../components/SubscribeForm.astro";
import { cats, deptHref, newsletterLive } from "../../data/site";
import { getEntries, deptCounts } from "../../lib/entries";
import { abs, pageNode, itemList, crumbs } from "../../lib/schema";
import { pageCard } from "../../lib/og";

const entries = await getEntries();
const counts = deptCounts(entries);
const filters = [{ key: "all", n: "00", name: "All entries" }, ...cats];

const url = abs("/blog/");
const description =
  "Every entry filed by Strictly FYI, newest first: short answers to questions about science, history, tech, culture and everyday life.";

const schema = [
  pageNode("CollectionPage", url, "The Archive", description, {
    breadcrumb: { "@id": `${url}#breadcrumb` },
    mainEntity: { "@id": `${url}#list` },
  }),
  itemList(url, entries),
  crumbs(url, [{ name: "Archive", url }]),
];

/* The ?cat= filter survives for links already out in the wild; new links go to
   the department pages. It is applied before first paint: this script runs
   while the page is still parsing, before the filter bar and the rows exist,
   and sets html[data-cat]. The rules below do the hiding, so nothing collapses
   once the rows are on screen. An unknown value falls back to "all". The same
   attribute doubles as the has-script flag that reveals the filter bar, whose
   buttons do nothing without script. */
const keys = cats.map((c) => c.key);
const prepaint =
  `(function(){var c="all";try{var q=new URLSearchParams(location.search).get("cat");` +
  `if(q&&${JSON.stringify(keys)}.indexOf(q)>-1)c=q}catch(e){}` +
  `document.documentElement.setAttribute("data-cat",c)})();`;

/* Generated from the department list so the rules cannot drift from it. */
const prepaintCss = [
  "html[data-cat] .arch-filter{display:flex}",
  ...keys.map((k) => `html[data-cat="${k}"] .arch-ledger .row[data-cat]:not([data-cat="${k}"]){display:none}`),
  ...keys.map((k) => `html[data-cat="${k}"] .dept-note[data-cat="${k}"]{display:block}`),
  filters.map((f) => `html[data-cat="${f.key}"] .dept[data-cat="${f.key}"]`).join(",") +
    "{color:var(--ink);border-bottom-color:var(--ink)}",
  filters.map((f) => `html[data-cat="${f.key}"] .dept[data-cat="${f.key}"] .dept-n`).join(",") +
    "{background:var(--hl);color:var(--ink)}",
].join("");
---

<Layout
  title="The Archive - Strictly FYI"
  description={description}
  card={pageCard("archive")}
  schema={schema}
>
  <div class="archive wrap">
    <header class="arch-head">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a> <span aria-hidden="true">/</span> <span aria-current="page">Archive</span>
      </nav>
      <p class="arch-kicker">The Archive &middot; {entries.length} entries filed &middot; Newest first</p>
      <h1 class="arch-title">Everything worth <span class="hl-live">knowing</span>.</h1>
      <p class="arch-dek">
        Short entries on the fascinating, filed by department and listed newest first.
      </p>
    </header>

    <script is:inline set:html={prepaint}></script>
    <style is:inline set:html={prepaintCss}></style>

    <div class="arch-filter" role="group" aria-label="Filter the archive by department">
      {filters.map((f) => (
        <button
          type="button"
          class="dept"
          data-cat={f.key}
          aria-pressed={f.key === "all" ? "true" : "false"}
          data-track="archive_filter"
          data-track-filter-category={f.key}
        >
          <span class="dept-n" aria-hidden="true">&sect;{f.n}</span>{f.name}
        </button>
      ))}
    </div>
    <p class="vh" id="arch-status" role="status"></p>

    {cats.map((c) => (
      <p class="dept-note" data-cat={c.key}>
        {(counts[c.key] ?? 0) > 0 ? (
          <>
            Showing the {counts[c.key]} entries filed under {c.name}. The department also has
            <a href={deptHref(c.key)}>its own page</a>, with an introduction.
          </>
        ) : (
          <>Nothing is filed under {c.name} yet.</>
        )}
      </p>
    ))}

    <ol class="ledger arch-ledger">
      {entries.map((p) => <LedgerRow entry={p} cv />)}
    </ol>

    <section class="arch-foot" aria-label="Follow new entries">
      <p class="arch-foot-copy">
        {newsletterLive ? "Get new entries by email." : "Every new entry goes into the feed."}
      </p>
      <SubscribeForm location="archive" />
    </section>
  </div>
</Layout>

<style>
  .archive { padding-top: clamp(1.75rem, 5vw, 3rem); }

  /* -------- HEAD -------- */
  .arch-head { padding-bottom: 1.8rem; }
  .crumbs {
    display: flex; gap: 0.45rem; flex-wrap: wrap; padding-bottom: 0.9rem;
    font-family: var(--mono); font-size: 0.66rem; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--ink-faint);
  }
  .crumbs a {
    color: var(--ink-soft); text-decoration: none;
    transition: background var(--t-hover) var(--ease-out), color var(--t-hover) var(--ease-out);
  }
  .arch-kicker {
    font-family: var(--mono); font-size: 0.7rem; letter-spacing: 0.13em;
    text-transform: uppercase; color: var(--ink-faint);
  }
  .arch-title {
    font-family: var(--display); font-weight: 700;
    font-size: clamp(2.4rem, 7vw, 5rem); line-height: 0.98; letter-spacing: -0.025em;
    margin: 0.55rem 0 0;
  }
  .arch-dek {
    font-family: var(--serif); font-size: clamp(1.05rem, 2vw, 1.25rem);
    color: var(--ink-soft); max-width: 31.75rem; margin-top: 0.9rem; line-height: 1.5;
  }

  /* -------- DEPARTMENT FILTER --------
     Hidden until the pre-paint script marks the page as scripted. */
  .arch-filter {
    display: none; flex-wrap: wrap; gap: 0 1.4rem;
    padding: 0.6rem 0; border-top: 1px solid var(--ink);
  }
  .dept {
    font-family: var(--mono); font-size: 0.72rem; letter-spacing: 0.09em; text-transform: uppercase;
    background: none; border: none; border-radius: 0; cursor: pointer;
    color: var(--ink-faint); padding: 0.35rem 0;
    border-bottom: 2px solid transparent;
    transition: color var(--t-hover) var(--ease-out), border-color var(--t-hover) var(--ease-out),
      transform var(--t-press) var(--ease-out);
  }
  .dept-n { color: var(--ink-faint); margin-right: 0.45rem; }
  .dept:active { transform: scale(0.97); }

  .dept-note {
    display: none;
    font-family: var(--serif); font-style: italic; font-size: 1.05rem; line-height: 1.5;
    color: var(--ink-soft); padding: 0.15rem 0 0.9rem;
  }
  .dept-note a { color: var(--ink); }

  /* -------- THE LEDGER -------- */
  .ledger { list-style: none; margin: 0; padding: 0; }
  .arch-ledger { border-top: 1px solid var(--ink); border-bottom: 1px solid var(--ink); }

  /* -------- FOOT -------- */
  .arch-foot {
    display: flex; justify-content: space-between; align-items: center;
    gap: 1.25rem 2rem; flex-wrap: wrap; padding: 2rem 0 0;
  }
  .arch-foot-copy {
    font-family: var(--display); font-weight: 600; font-style: italic;
    font-size: clamp(1.2rem, 2.6vw, 1.7rem); line-height: 1.25;
    max-width: 30.75rem; margin: 0;
  }

  @media (hover: hover) and (pointer: fine) {
    .dept:hover { color: var(--ink); }
    .crumbs a:hover { background: var(--hl); color: var(--ink); }
  }

  @media (max-width: 520px) {
    .arch-filter { gap: 0 1rem; }
  }

  .vh {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
  }
</style>

<script>
  /* Clicks on the department filter. The pre-paint script already set
     html[data-cat] from ?cat=, and the generated rules do the hiding, so this
     only keeps that attribute, aria-pressed and the address bar in step. The
     archive_filter event comes from the buttons' data-track attributes. */
  const root = document.documentElement;
  const buttons = [...document.querySelectorAll<HTMLButtonElement>(".arch-filter .dept")];
  const status = document.getElementById("arch-status");

  /* The pressed button carries no data-track, so pressing it again does not
     log a second archive_filter for a filter that is already on. */
  const sync = () => {
    const current = root.dataset.cat || "all";
    for (const b of buttons) {
      const on = b.dataset.cat === current;
      b.setAttribute("aria-pressed", String(on));
      if (on) b.removeAttribute("data-track");
      else b.setAttribute("data-track", "archive_filter");
    }
  };

  /* The list changes without moving focus, so say what changed (WCAG 4.1.3). */
  const announce = (cat: string) => {
    if (!status) return;
    const note = document.querySelector<HTMLElement>(`.dept-note[data-cat="${cat}"]`);
    status.textContent =
      cat === "all"
        ? `Showing all ${document.querySelectorAll(".arch-ledger > li").length} entries.`
        : (note?.textContent ?? "").replace(/\s+/g, " ").trim();
  };

  for (const b of buttons) {
    b.addEventListener("click", () => {
      const cat = b.dataset.cat || "all";
      if (cat === (root.dataset.cat || "all")) return;
      root.dataset.cat = cat;
      sync();
      announce(cat);
      const url = new URL(location.href);
      if (cat === "all") url.searchParams.delete("cat");
      else url.searchParams.set("cat", cat);
      history.replaceState(history.state, "", url);
    });
  }
  sync();
</script>
