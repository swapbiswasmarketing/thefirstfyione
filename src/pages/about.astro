---
import Layout from "../layouts/Layout.astro";
import SubscribeForm from "../components/SubscribeForm.astro";
import { contactEmail, contactLive, newsletterLive } from "../data/site";
import { pageNode, crumbs, abs, ORG_ID } from "../lib/schema";
import { pageCard } from "../lib/og";

const principles = [
  {
    n: "01",
    t: "Short and complete",
    d: "Every entry earns its length. We explain the whole idea, then stop. No 2,000-word warm-up to reach the one interesting paragraph.",
  },
  {
    n: "02",
    t: "Actually true",
    d: "We chase the real explanation, not the fun-sounding myth, and we link the sources behind what we say so you can check them. If something is disputed or simplified, we say so in the entry.",
  },
  {
    n: "03",
    t: "Plain English",
    d: "You should not need a degree to enjoy a good fact. We translate the science, history, and jargon into something a curious human can hold.",
  },
  {
    n: "04",
    t: "The 'huh' test",
    d: "One rule decides what runs: does it make you think 'huh, I didn't know that'? If not, it stays in the drawer.",
  },
];

const description =
  "What Strictly FYI is: a general-interest field guide to the fascinating, written for curious people who like knowing how things really work.";
const url = abs("/about/");

/* One trail for the visible breadcrumb and the BreadcrumbList. The
   Organization's publishingPrinciples points at #house-rules below. */
const trail = [
  { name: "Home", href: "/" },
  { name: "About", href: "/about/" },
];
const schema = [
  pageNode("AboutPage", url, "About Strictly FYI", description, {
    mainEntity: { "@id": ORG_ID },
    breadcrumb: { "@id": `${url}#breadcrumb` },
  }),
  crumbs(url, trail.slice(1).map((c) => ({ name: c.name, url: abs(c.href) }))),
];
const correctionHref = `mailto:${contactEmail}?subject=${encodeURIComponent("Correction")}`;
---

<Layout
  title="About - Strictly FYI"
  description={description}
  card={pageCard("about")}
  schema={schema}
  contentGroup="About"
>
  <div class="about wrap">
    <header class="ab-head">
      <nav class="crumbs" aria-label="Breadcrumb">
        <ol>
          {trail.map((c, i) => (
            <li>
              {i > 0 && <span class="crumb-sep" aria-hidden="true">/</span>}
              {i < trail.length - 1 ? <a href={c.href}>{c.name}</a> : <span aria-current="page">{c.name}</span>}
            </li>
          ))}
        </ol>
      </nav>
      <p class="ab-kicker">About the publication &middot; Est. MMXXVI</p>
      <h1 class="ab-title">A field guide to the <span class="hl-live">fascinating</span>.</h1>
    </header>

    <section class="ab-body">
      <div class="ab-lede">
        <p>
          Strictly FYI is for people who read the plaque at the museum, who fall down Wikipedia
          rabbit holes, who want to know <em>why</em> the airplane window is round.
        </p>
      </div>

      <div class="ab-col">
        <p>
          The internet is drowning in content and starved of the good kind: short, true, and
          genuinely interesting. Most "did you know" facts are either wrong, decades out of date,
          or stretched into an endless article to sell you something at the bottom.
        </p>
        <p>
          <strong>Strictly FYI is the antidote.</strong> We pick questions whose real answer beats the
          one you usually hear: why <a href="/blog/what-does-sos-stand-for/">SOS never stood for
          anything</a>, why <a href="/blog/what-is-the-longest-word-in-the-world/">the longest word in
          the world depends on who is counting</a>, and how <a href="/blog/where-does-santa-live/">a
          magazine page from 1866 put Santa's home at the North Pole</a>. We tell you the real story,
          plainly, with the sources linked, and then we get out of your way.
        </p>
        <blockquote>The name says it all: interesting things, strictly for your information.</blockquote>
        <p>
          No hot takes, no outrage, no algorithm bait. Just the small, sturdy pleasure of learning
          something true and thinking, <em>huh, I'm glad I know that now.</em>
        </p>
      </div>
    </section>

    <section class="corr" id="who" aria-labelledby="who-head">
      <h2 class="rules-head" id="who-head">Who makes it &middot; And how</h2>
      <div class="corr-body">
        <p class="corr-lede">An independent publication, drafted with AI and checked against its sources.</p>
        <div class="corr-col">
          <p>
            Strictly FYI is an independent publication. Entries carry its name rather than a personal byline,
            and the publication answers for every one of them. It takes no sponsorship and runs no affiliate links.
          </p>
          <p>
            Entries are researched and drafted with AI tools, then checked against the pages they cite, by a
            fact-checking pass and by a script that tests quotations and figures against those pages. A person sets
            the rules, decides what is published, and handles corrections. <a href="/how-we-work/">How we work</a>
            describes each step and when each check began.
          </p>
        </div>
      </div>
    </section>

    <section class="rules" id="house-rules" aria-labelledby="house-rules-head">
      <h2 class="rules-head" id="house-rules-head">House rules &middot; How we pick and write</h2>
      <ol class="rules-list">
        {principles.map((p) => (
          <li class="rule-row">
            <span class="rule-n">&sect;{p.n}</span>
            <span class="rule-body">
              <span class="rule-t">{p.t}</span>
              <span class="rule-d">{p.d}</span>
            </span>
          </li>
        ))}
      </ol>
    </section>

    <section class="corr" id="corrections" aria-labelledby="corrections-head">
      <h2 class="rules-head" id="corrections-head">Corrections &middot; When an entry is wrong</h2>
      <div class="corr-body">
        <p class="corr-lede">Errors are fixed in the entry itself, and the entry is marked Updated.</p>
        <div class="corr-col">
          <p>
            When an entry gets a fact wrong, the text is corrected where the error was, the dateline
            under the headline shows the date of the fix, and the change is listed in the
            <a href="/corrections/">corrections log</a>.
          </p>
          {contactLive && (
            <p>
              To report one, write to <a href={correctionHref}>{contactEmail}</a> or use the
              <a href="/contact/">contact page</a>. Name the entry, say what is wrong, and include a
              source that shows it.
            </p>
          )}
        </div>
      </div>
    </section>

    <section class="ab-foot" aria-labelledby="ab-foot-head">
      <div class="ab-foot-pitch">
        {newsletterLive ? (
          <>
            <p class="ab-foot-head" id="ab-foot-head">Get new entries by email.</p>
            <p class="ab-foot-sub">Confirm once from your inbox. Every email has an unsubscribe link.</p>
          </>
        ) : (
          <>
            <p class="ab-foot-head" id="ab-foot-head">New entries, as they are filed.</p>
            <p class="ab-foot-sub">
              Every new entry goes into the RSS feed when it is published. Add the feed to any reader; no
              email address needed.
            </p>
          </>
        )}
        <div class="ab-foot-form">
          <SubscribeForm location="about" size="lg" />
        </div>
      </div>
      <div class="ab-foot-actions">
        <a href="/blog/" class="btn">Read the archive</a>
      </div>
    </section>
  </div>
</Layout>

<style>
  .about { padding-top: clamp(1.75rem, 5vw, 3rem); }

  /* -------- HEAD -------- */
  .crumbs ol {
    list-style: none; display: flex; gap: 0.45rem; min-width: 0;
    font-family: var(--mono); font-size: 0.66rem; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--ink-faint); padding-bottom: 1.1rem;
  }
  /* Flex rows, so the whitespace between a separator and its link renders as
     nothing and every gap is the same 0.45rem. */
  .crumbs li { display: flex; gap: 0.45rem; flex: none; white-space: nowrap; }
  .crumbs a {
    color: var(--ink-soft); text-decoration: none;
    transition: background var(--t-hover) var(--ease-out), color var(--t-hover) var(--ease-out);
  }

  .ab-kicker {
    font-family: var(--mono); font-size: 0.7rem; letter-spacing: 0.13em;
    text-transform: uppercase; color: var(--ink-faint);
  }
  /* Measures are in em and rem, not ch: ch follows whichever face has loaded,
     so a font swap would rewrap the text. Converted at the loaded faces' zero
     widths: Playfair Display 700 0.645em, Newsreader 0.55em. */
  .ab-title {
    font-family: var(--display); font-weight: 700;
    font-size: clamp(2.4rem, 7.5vw, 5.5rem); line-height: 0.96; letter-spacing: -0.03em;
    margin: 0.6rem 0 1.4rem; max-width: 10.3em;
  }

  /* -------- BODY: lede rail + column -------- */
  .ab-body {
    display: grid; grid-template-columns: minmax(0, 1fr);
    gap: 2rem; border-top: 1px solid var(--ink); padding-top: 2rem;
  }
  .ab-lede p {
    font-family: var(--display); font-weight: 600; font-style: italic;
    font-size: clamp(1.35rem, 2.8vw, 1.9rem); line-height: 1.28; letter-spacing: -0.015em;
    color: var(--ink); margin: 0;
  }
  .ab-lede em { font-style: normal; }

  .ab-col { min-width: 0; max-width: 39.2rem; font-family: var(--serif); font-size: 1.15rem; line-height: 1.7; color: #24252b; }
  .ab-col p { margin: 0 0 1.15rem; }
  .ab-col strong { font-weight: 600; color: var(--ink); }
  .ab-col em { font-style: italic; }
  .ab-col blockquote {
    margin: 1.8rem 0; padding-left: 1.4rem; border-left: 3px solid var(--ink);
    font-family: var(--display); font-style: italic; font-weight: 600;
    font-size: clamp(1.25rem, 2.6vw, 1.55rem); line-height: 1.3; color: var(--ink);
  }

  /* -------- HOUSE RULES + CORRECTIONS -------- */
  .rules, .corr { margin-top: clamp(2.5rem, 6vw, 4rem); }
  /* A mono label set as an h2: undo the global heading face. */
  .rules-head {
    font-family: var(--mono); font-weight: 400; font-size: 0.68rem; line-height: 1.6;
    letter-spacing: 0.14em; text-transform: uppercase; text-wrap: wrap;
    color: var(--ink-faint); padding-bottom: 0.6rem;
    border-top: 1px solid var(--ink); border-bottom: 1px solid var(--ink);
    padding-top: 0.6rem;
  }
  .rules-list { list-style: none; margin: 0; padding: 0; }
  .rule-row {
    display: grid; grid-template-columns: 3.2rem minmax(0, 1fr); gap: 0 1.5rem;
    padding: 1.35rem 0; border-bottom: 1px solid var(--rule); align-items: baseline;
  }
  .rule-n { font-family: var(--mono); font-size: 0.72rem; color: var(--ink-faint); }
  .rule-t {
    display: block; font-family: var(--display); font-weight: 700;
    font-size: clamp(1.3rem, 2.6vw, 1.75rem); line-height: 1.1; letter-spacing: -0.015em;
  }
  .rule-d {
    display: block; font-family: var(--serif); font-size: 1.05rem; line-height: 1.6;
    color: var(--ink-soft); margin-top: 0.45rem; max-width: 35.2rem;
  }

  .corr-body {
    display: grid; grid-template-columns: minmax(0, 1fr); gap: 1rem 3rem;
    padding: 1.35rem 0 1.5rem; border-bottom: 1px solid var(--rule);
  }
  .corr-lede {
    font-family: var(--display); font-weight: 700;
    font-size: clamp(1.3rem, 2.6vw, 1.75rem); line-height: 1.15; letter-spacing: -0.015em;
    max-width: 15em;
  }
  .corr-col p {
    font-family: var(--serif); font-size: 1.05rem; line-height: 1.6; color: var(--ink-soft);
    max-width: 35.2rem;
  }
  .corr-col p + p { margin-top: 0.8rem; }
  .corr-col a, .ab-col a {
    color: var(--ink); text-decoration: underline; text-decoration-thickness: 1px;
    text-underline-offset: 0.16em; text-decoration-color: var(--rule-mid);
    transition: background var(--t-hover) var(--ease-out), text-decoration-color var(--t-hover) var(--ease-out);
  }

  /* -------- FOOT -------- */
  .ab-foot {
    display: flex; justify-content: space-between; align-items: flex-end;
    gap: 1.5rem 2.5rem; flex-wrap: wrap; margin-top: 2.5rem; padding-top: 1.6rem;
    border-top: 1px solid var(--ink);
  }
  .ab-foot-head {
    font-family: var(--display); font-weight: 700;
    font-size: clamp(1.5rem, 3.6vw, 2.4rem); line-height: 1.08; letter-spacing: -0.02em;
    max-width: 11.6em;
  }
  .ab-foot-sub {
    font-family: var(--serif); color: var(--ink-soft); max-width: 26.5rem; margin-top: 0.6rem;
  }
  .ab-foot-form { margin-top: 1rem; }
  .ab-foot-actions { display: flex; gap: 0.6rem; flex-wrap: wrap; }

  /* -------- HOVER (gated) -------- */
  @media (hover: hover) and (pointer: fine) {
    .crumbs a:hover { background: var(--hl); color: var(--ink); }
    .corr-col a:hover, .ab-col a:hover { background: var(--hl); text-decoration-color: var(--ink); }
  }

  /* -------- RESPONSIVE -------- */
  @media (min-width: 900px) {
    .ab-body { grid-template-columns: 5fr 7fr; gap: 3rem; }
    .ab-lede { border-right: 1px solid var(--rule); padding-right: 2rem; }
    .corr-body { grid-template-columns: 5fr 7fr; }
  }
  @media (max-width: 520px) {
    .rule-row { grid-template-columns: 1fr; gap: 0.35rem; }
  }
</style>
