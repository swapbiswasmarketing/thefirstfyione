---
import Layout from "../layouts/Layout.astro";
import SubscribeForm from "../components/SubscribeForm.astro";
import { cats, catLabel, deptHref, deptWord, fmtDate, fmtDay, newsletterLive, SITE_URL, SITE_NAME, SITE_DESCRIPTION } from "../data/site";
import {
  getEntries,
  entryHref,
  readingLabel,
  openingParagraph,
  pullQuote,
  askWord,
  ASK_WORDS,
  deptCounts,
  edition,
  inboundCounts,
  byFiled,
  type Entry,
} from "../lib/entries";
import { pageNode, abs, ORG_ID } from "../lib/schema";
import { pageCard } from "../lib/og";
import { keepTogether } from "../lib/typeset";

const entries = await getEntries();
const ed = edition(entries);
const latestDay = entries[0]?.data.pubDate.valueOf() ?? 0;

/* The newest filing leads. An entry from the newest filing date can be pinned
   with lead: true; a pin from an older date is ignored, so the front page can
   never freeze on one story again. */
const lead = entries.find((p) => p.data.lead && p.data.pubDate.valueOf() === latestDay) ?? entries[0];

/* Every module draws from one pool, so no entry appears twice on the page. */
const shown = new Set<string>([lead.id]);
const take = (list: Entry[], n: number) => {
  const out: Entry[] = [];
  for (const p of list) {
    if (out.length >= n) break;
    if (shown.has(p.id)) continue;
    shown.add(p.id);
    out.push(p);
  }
  return out;
};

/* The rest of the edition: four secondary stories under the lead, with their
   deks, and a rail of headlines beside it. */
const secondary = take(entries, 4);
const rail = take(entries, 8);
/* An edition smaller than the fold is topped up with earlier filings, and the
   labels say so instead of calling everything "this edition". */
const inEdition = (p: Entry) => p.data.pubDate.valueOf() === latestDay;
const secondaryLabel = secondary.every(inEdition) ? "More from this edition" : "Recently filed";
const railEdition = rail.filter(inEdition);
const railEarlier = rail.filter((p) => !inEdition(p));

/* 118 of the titles are questions, so the word a question opens with is the
   most natural index the archive has. */
const ASK_LABEL: Record<string, string> = { why: "Why", what: "What", how: "How", where: "Where", when: "When" };
const desk = ASK_WORDS.map((w) => {
  const all = entries.filter((p) => askWord(p.data.title) === w);
  return { w, label: ASK_LABEL[w], count: all.length, items: take(all, 3) };
});
const splitQ = (title: string) => {
  const i = title.indexOf("?");
  return i === -1 ? { q: title, hook: "" } : { q: title.slice(0, i + 1), hook: title.slice(i + 1).trim() };
};

/* Start here: the operator's pinned entries first, then the entries the rest
   of the archive links to most often. */
const inbound = inboundCounts(entries);
const startPinned = take(entries.filter((p) => p.data.featured), 2);
const byCited = [...entries].sort((a, b) => (inbound.get(b.id) ?? 0) - (inbound.get(a.id) ?? 0) || byFiled(a, b));
const startCited = take(byCited, 5 - startPinned.length);
const start = [
  ...startPinned.map((p) => ({ p, note: "Pinned" })),
  ...startCited.map((p) => ({ p, note: `Cited by ${inbound.get(p.id) ?? 0} entries` })),
];

const counts = deptCounts(entries);
const depts = cats.map((c) => ({
  ...c,
  count: counts[c.key] ?? 0,
  items: take(entries.filter((p) => p.data.category === c.key), 3),
}));

/* The almanac: one line per entry, lifted from its own verified text. A
   script picks the line for the reader's day, so it changes daily without a
   rebuild; "Another fact" advances it on request. Nothing rotates by itself. */
type Fact = { t: string; h: string; c: string; n: string };
const fromAlmanac: Fact[] = entries
  .filter((p) => p.data.almanac)
  .map((p) => ({ t: p.data.almanac!, h: entryHref(p), c: p.data.filecode ?? "FYI", n: p.data.title }));
const facts: Fact[] = fromAlmanac.length
  ? fromAlmanac
  : entries
      .map((p) => ({ p, q: pullQuote(p) }))
      .filter((x): x is { p: Entry; q: string } => !!x.q && x.q.length <= 170 && !/^["'(]/.test(x.q))
      .map(({ p, q }) => ({ t: q, h: entryHref(p), c: p.data.filecode ?? "FYI", n: p.data.title }));
const buildDay = Math.floor(Date.now() / 864e5);
const fact0 = facts.length ? facts[buildDay % facts.length] : null;
const factJson = JSON.stringify(facts).replace(/</g, "\\u003c");

/* Random file: the ids are baked in at build, so the list can never drift. */
const fileIds = JSON.stringify(entries.map((p) => p.id));

const placeholder = `Search ${ed.onFile} entries`;

/* The lead headline sets its last word on the highlighter band. */
const words = lead.data.title.trim().split(" ");
const leadLast = words.length > 1 ? words.pop()! : lead.data.title;
const leadHead = words.length ? `${words.join(" ")} ` : "";

/* The front page runs the opening of the lead story, then sends the reader inside. */
const leadOpening = (() => {
  const clean = openingParagraph(lead);
  if (clean.length <= 320) return clean;
  const sentences = clean.match(/[^.!?]+[.!?]+(\s|$)/g) ?? [clean];
  let out = "";
  for (const s of sentences) {
    if (out.length + s.length > 340 && out.length > 0) break;
    out += s;
  }
  return (out || clean.slice(0, 320)).trim();
})();

const pad3 = (n: number) => String(n).padStart(3, "0");
const iso = (d: Date) => d.toISOString().slice(0, 10);

const schema = [
  pageNode("WebPage", `${SITE_URL}/`, SITE_NAME, SITE_DESCRIPTION, {
    about: { "@id": ORG_ID },
    primaryImageOfPage: { "@type": "ImageObject", url: abs(pageCard("home").url) },
  }),
];
---

<Layout
  bare
  title="Strictly FYI: a field guide to the fascinating"
  schema={schema}
  card={pageCard("home")}
  contentGroup="Front page"
>
  <header class="mast wrap" slot="masthead">
    <div class="dateline">
      <span><span class="dl-long">Vol. {ed.vol} &middot; </span>No. {pad3(ed.no)}</span>
      <span class="dateline-mid">A field guide to the fascinating</span>
      <span>
        <span class="dl-long">Last filed <time datetime={iso(ed.latest)}>{fmtDay(ed.latest)}</time></span>
        <span class="dl-short">Filed {fmtDate(ed.latest)}</span>
      </span>
    </div>

    <div class="nameplate-row">
      <h1 class="nameplate"><span class="np">Strictly</span> <span class="np hl-live">FYI</span></h1>
      <p class="mast-meta">
        <span><span class="fig">{ed.onFile}</span> entries on file</span>
        <span><span class="fig">{ed.inEdition}</span> in this edition</span>
        <span><span class="fig">{ed.questions}</span> questions answered</span>
      </p>
    </div>

    <div class="rule-thickthin"></div>

    <div class="mast-tools">
      <nav class="dept-nav" aria-label="Departments">
        {depts.map((c) => (
          <a href={deptHref(c.key)} aria-label={`${c.name}, ${c.count} entries`}><span class="sec" aria-hidden="true">&sect;{c.n}</span>{c.name}<span class="cnt" aria-hidden="true">{c.count}</span></a>
        ))}
      </nav>
      <div class="mast-actions">
        <form class="mast-search" role="search" action="/search/" method="get">
          <label class="sr-only" for="mast-q">Search the archive</label>
          <input id="mast-q" name="q" type="search" placeholder={placeholder} autocomplete="off" enterkeyhint="search" />
          <button type="submit" class="coupon" data-track="cta_click" data-track-cta-type="search" data-track-cta-location="masthead">[ Search ]</button>
        </form>
        <a href="/blog/" class="coupon random-file" id="random-file" data-track="random_entry" data-track-random-location="home">[ Pull a random file ]</a>
      </div>
    </div>
  </header>

  <div class="gazette wrap">
    {/* ============ THE FOLD ============ */}
    <div class="fold">
      <div class="lead-col">
      <article class="lead" aria-labelledby="lead-h">
        <p class="lead-kicker">
          {lead.data.filecode} &middot; <a href={deptHref(lead.data.category)}>{catLabel[lead.data.category]}</a> &middot; The lead
        </p>
        <h2 class="lead-head" id="lead-h">
          <a href={entryHref(lead)} data-track="home_module_click" data-track-module="lead" data-track-position="1"><Fragment set:html={keepTogether(leadHead)} /><span class="hl-live nb">{leadLast}</span></a>
        </h2>
        <p class="lead-dek">{lead.data.description}</p>
        <p class="lead-meta">
          <span>Filed <time datetime={iso(lead.data.pubDate)}>{fmtDate(lead.data.pubDate)}</time></span>
          <span class="leader" aria-hidden="true"></span>
          <span>{readingLabel(lead)}</span>
        </p>
        {leadOpening && (
          <div class="lead-body">
            <p>
              {leadOpening}{" "}
              <a href={entryHref(lead)} class="lead-cont" data-track="home_module_click" data-track-module="lead_continue" data-track-position="1">Continued inside</a>
            </p>
          </div>
        )}
      </article>

      <section class="second" aria-labelledby="second-h">
        <h2 class="sr-only" id="second-h">{secondaryLabel}</h2>
        <div class="second-grid">
          {secondary.map((p, i) => (
            <article class="story">
              <p class="story-kicker">{p.data.filecode} &middot; {catLabel[p.data.category]}</p>
              <h3 class="story-head">
                <a class="row-link" href={entryHref(p)} data-track="home_module_click" data-track-module="secondary" data-track-position={String(i + 1)}><Fragment set:html={keepTogether(p.data.title)} /></a>
              </h3>
              <p class="story-dek">{p.data.description}</p>
              <span class="row-time">{readingLabel(p)}</span>
            </article>
          ))}
        </div>
      </section>
      </div>

      <section class="rail" aria-labelledby="rail-h">
        <h2 class="label-head" id="rail-h">{railEdition.length ? "Inside this edition" : "Recently filed"}</h2>
        {[railEdition, railEarlier].map((group, g) =>
          group.length > 0 && (
            <>
              {g === 1 && railEdition.length > 0 && <h3 class="label-head rail-sub">Filed earlier</h3>}
              <ol class="rail-list stagger">
                {group.map((p, i) => (
                  <li class="row">
                    <span class="row-num">{p.data.filecode}</span>
                    <div class="row-body">
                      <span class="row-kicker">{catLabel[p.data.category]} &middot; {readingLabel(p)}</span>
                      <h3 class="row-head">
                        <a class="row-link" href={entryHref(p)} data-track="home_module_click" data-track-module="edition" data-track-position={String(i + 1 + (g === 1 ? railEdition.length : 0))}><Fragment set:html={keepTogether(p.data.title)} /></a>
                      </h3>
                    </div>
                  </li>
                ))}
              </ol>
            </>
          )
        )}
        <a href="/blog/" class="rail-all">All {ed.inEdition} filed {fmtDate(ed.latest)}, in the archive</a>
      </section>
    </div>

    {/* ============ THE QUESTION DESK ============ */}
    <section class="desk" aria-labelledby="desk-h">
      <div class="shead">
        <span class="kick">Index</span>
        <h2 id="desk-h">The question desk</h2>
        <span class="folio">Filed by the word each question opens with</span>
      </div>
      <div class="desk-grid">
        {desk.map((d) => (
          <div class="desk-col">
            <h3 class="desk-word"><span class="dw">{d.label}</span> <span class="dc">{d.count} on file</span></h3>
            <ol class="desk-list">
              {d.items.map((p, i) => {
                const { q, hook } = splitQ(p.data.title);
                return (
                  <li class="desk-item">
                    <a href={entryHref(p)} data-track="home_module_click" data-track-module={`desk_${d.w}`} data-track-position={String(i + 1)}>
                      <span class="dq" set:html={keepTogether(q)} />
                      {hook && <span class="dh">{hook}</span>}
                    </a>
                  </li>
                );
              })}
            </ol>
          </div>
        ))}
      </div>
    </section>

    {/* ============ ALMANAC + START HERE ============ */}
    <div class="split">
      {fact0 && (
        <aside class="almanac" aria-labelledby="alm-h">
          <div class="almanac-head">
            <h2 id="alm-h">The almanac</h2>
            <span>Fact of the day &middot; from the archive</span>
          </div>
          <figure class="fact" aria-live="polite">
            <blockquote class="fact-text" id="fact-text" cite={abs(fact0.h)}>{fact0.t}</blockquote>
            <figcaption class="fact-src">
              From <a id="fact-link" href={fact0.h} data-track="home_module_click" data-track-module="almanac" data-track-position="1"><span id="fact-code">{fact0.c}</span> &middot; <span id="fact-title">{fact0.n}</span></a>
            </figcaption>
          </figure>
          <div class="almanac-foot">
            <button type="button" class="coupon" id="fact-next" data-track="home_module_click" data-track-module="almanac_next" data-track-position="1" hidden>[ Another fact ]</button>
            <span class="almanac-count">{facts.length} facts on file</span>
          </div>
          <script type="application/json" id="fact-data" set:html={factJson} is:inline />
          <script is:inline>
            (function () {
              var el = document.getElementById("fact-data");
              var data = el ? JSON.parse(el.textContent || "[]") : [];
              if (!data.length) return;
              var now = new Date();
              var i = Math.floor((now.getTime() - now.getTimezoneOffset() * 6e4) / 864e5) % data.length;
              var t = document.getElementById("fact-text");
              var l = document.getElementById("fact-link");
              var c = document.getElementById("fact-code");
              var n = document.getElementById("fact-title");
              var b = document.getElementById("fact-next");
              function show(k) {
                var f = data[k];
                t.textContent = f.t;
                t.setAttribute("cite", location.origin + f.h);
                l.setAttribute("href", f.h);
                c.textContent = f.c;
                n.textContent = f.n;
              }
              show(i);
              if (b && data.length > 1) {
                b.hidden = false;
                b.addEventListener("click", function () {
                  i = (i + 1) % data.length;
                  show(i);
                });
              }
            })();
          </script>
        </aside>
      )}

      <section class="start" aria-labelledby="start-h">
        <h2 class="label-head" id="start-h">Start here</h2>
        <ol class="start-list">
          {start.map(({ p, note }, i) => (
            <li class="row">
              <span class="row-num">{p.data.filecode}</span>
              <div class="row-body">
                <span class="row-kicker">{catLabel[p.data.category]} &middot; {note}</span>
                <h3 class="row-head">
                  <a class="row-link" href={entryHref(p)} data-track="home_module_click" data-track-module="start" data-track-position={String(i + 1)}><Fragment set:html={keepTogether(p.data.title)} /></a>
                </h3>
                <p class="row-dek">{p.data.description}</p>
              </div>
            </li>
          ))}
        </ol>
      </section>
    </div>

    {/* ============ DEPARTMENTS ============ */}
    <section class="depts" id="index" aria-labelledby="depts-h">
      <div class="shead">
        <span class="kick">Sections</span>
        <h2 id="depts-h">Departments</h2>
        <span class="folio">{ed.onFile} entries in {deptWord} departments</span>
      </div>
      <div class="dept-grid">
        {depts.map((c) => (
          <section class="dept" aria-labelledby={`dept-${c.key}`}>
            <h3 class="dept-name" id={`dept-${c.key}`}>
              <a href={deptHref(c.key)}><span class="sec" aria-hidden="true">&sect;{c.n}</span>{c.name}</a>
            </h3>
            <p class="dept-note">{c.note}</p>
            <ul class="dept-list">
              {c.items.map((p, i) => (
                <li>
                  <a href={entryHref(p)} data-track="home_module_click" data-track-module={`dept_${c.key}`} data-track-position={String(i + 1)}><Fragment set:html={keepTogether(p.data.title)} /></a>
                </li>
              ))}
            </ul>
            <a class="dept-all" href={deptHref(c.key)}>All {c.count} in {c.name}</a>
          </section>
        ))}
      </div>
    </section>

    {/* ============ FOLLOW ============ */}
    <section class="follow" id="subscribe" aria-labelledby="follow-h">
      <div class="follow-copy">
        {newsletterLive ? (
          <>
            <h2 class="follow-head" id="follow-h">By post &amp; by <span class="hl">inbox</span>.</h2>
            <p class="follow-sub">New entries by email as they are filed. One click to leave.</p>
          </>
        ) : (
          <>
            <h2 class="follow-head" id="follow-h">By <span class="hl">feed</span>.</h2>
            <p class="follow-sub">
              Every entry reaches the RSS feed the day it is filed, so a feed reader gets the whole archive as it
              grows. No email address needed.
            </p>
          </>
        )}
      </div>
      <SubscribeForm location="homepage" size="lg" />
    </section>
  </div>

  <script type="application/json" id="file-ids" set:html={fileIds} is:inline />
  <script>
    /* Random file. Without script the link opens the archive. With it, the
       link itself points at a random entry, picked on load and again on a
       back-forward restore, so a plain click, a new tab and the tracked click
       all go to the same place. */
    const link = document.getElementById("random-file") as HTMLAnchorElement | null;
    const raw = document.getElementById("file-ids")?.textContent;
    const ids: string[] = raw ? JSON.parse(raw) : [];
    const pick = () => {
      if (link && ids.length) link.href = `/blog/${ids[Math.floor(Math.random() * ids.length)]}/`;
    };
    pick();
    addEventListener("pageshow", (e) => {
      if (e.persisted) pick();
    });
  </script>
</Layout>

<style>
  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
  }
  .gazette { padding-bottom: 1rem; }
  .gazette a, .mast a { text-decoration: none; color: var(--ink); }

  /* -------- MASTHEAD -------- */
  .mast { padding-top: 1.2rem; }
  .dateline {
    display: flex; justify-content: space-between; gap: 1rem;
    font-family: var(--mono); font-size: 0.66rem; letter-spacing: 0.13em; text-transform: uppercase;
    color: var(--ink-faint); border-bottom: 1px solid var(--ink); padding-bottom: 0.5rem;
  }
  .dateline-mid { color: var(--ink-soft); }
  .dl-short { display: none; }

  .nameplate-row {
    display: flex; justify-content: space-between; align-items: flex-end; gap: 1.5rem;
    padding: 0.9rem 0 0.5rem;
  }
  /* One line, never wrapped, sized from the viewport rather than from the
     text, so the line breaks the same way in the fallback font and in
     Playfair and the swap cannot push the page down. Measured: the nameplate
     is 6.57em wide in Playfair 900 and 7.16em in the Georgia fallback, so the
     size is solved for the wider of the two: (measure - meta column) / 7.16. */
  .nameplate {
    font-family: var(--display); font-weight: 900; text-transform: uppercase;
    font-size: min(8.25rem, calc(12.6vw - 30px)); line-height: 0.84; letter-spacing: -0.035em;
    margin: 0;
  }
  /* Each word holds together; the space between them is the only break, and
     the size above means it is never taken unless a reader's own spacing
     settings widen the text, when wrapping beats clipping (WCAG 1.4.12). */
  .np { white-space: nowrap; }
  /* The nameplate sets solid (line-height 0.84), so the house band would run
     into the double rule below it; stop it higher. */
  .nameplate .hl-live { background-image: linear-gradient(transparent 52%, var(--hl) 52%, var(--hl) 84%, transparent 84%); }
  .mast-meta {
    display: grid; justify-items: end; flex-shrink: 0; margin: 0 0 0.45rem;
    font-family: var(--mono); font-size: 0.66rem; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--ink-faint); line-height: 1.75;
  }
  .mast-meta .fig { color: var(--ink); }

  .mast-tools {
    display: flex; align-items: center; justify-content: space-between; gap: 0.8rem 2rem; flex-wrap: wrap;
    padding: 0.55rem 0; border-bottom: 1px solid var(--ink);
  }
  .dept-nav {
    display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.3rem 1.15rem;
    font-family: var(--mono); font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase;
  }
  .dept-nav a {
    color: var(--ink-soft); padding: 0.15rem 0;
    transition: color var(--t-hover) var(--ease-out), background var(--t-hover) var(--ease-out);
  }
  .dept-nav .sec { color: var(--ink-faint); margin-right: 0.35rem; }
  .dept-nav .cnt { color: var(--ink-faint); margin-left: 0.35rem; font-size: 0.62rem; }

  .mast-actions { display: flex; align-items: center; gap: 0.4rem 1.1rem; flex-wrap: wrap; }
  .mast-search { display: flex; align-items: baseline; gap: 0.5rem; }
  .mast-search input {
    width: 15rem; border: none; border-bottom: 1px solid var(--ink); border-radius: 0;
    background: transparent; padding: 0.3rem 0; color: var(--ink);
    font-family: var(--serif); font-style: italic; font-size: 1rem;
  }
  .mast-search input::placeholder { color: var(--ink-faint); }
  .mast-search input:focus { outline: none; background: linear-gradient(transparent 68%, var(--hl) 68%); }
  .mast-search input:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }
  .mast-search input::-webkit-search-cancel-button { cursor: pointer; }
  .mast-actions .coupon { font-size: 0.74rem; white-space: nowrap; }

  /* -------- THE FOLD: 8/4 -------- */
  .fold { display: grid; grid-template-columns: 8fr 4fr; }
  .lead-col {
    min-width: 0; padding: 1.8rem 2.2rem 1.2rem 0;
    border-right: 1px solid var(--rule-mid);
  }
  .lead { min-width: 0; }
  .lead-kicker {
    font-family: var(--mono); font-size: 0.72rem; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--ink-faint);
  }
  .lead-kicker a { color: var(--ink-faint); }
  .lead-head {
    font-family: var(--display); font-weight: 700;
    font-size: clamp(2.1rem, 5.2vw, 4.4rem); line-height: 0.98; letter-spacing: -0.02em;
    margin: 0.5rem 0 0;
  }
  .lead-dek {
    font-family: var(--serif); font-size: 1.18rem; line-height: 1.5; color: var(--ink-soft);
    max-width: 19rem; margin: 1.1rem 0 0 min(22%, 5rem);
  }
  .lead-meta {
    display: flex; align-items: baseline; gap: 0.7rem; flex-wrap: wrap; margin-top: 1.3rem;
    font-family: var(--mono); font-size: 0.72rem; color: var(--ink-faint);
  }
  .lead-meta .leader { flex: 1; min-width: 1.5rem; border-bottom: 1px dotted var(--ink-faint); transform: translateY(-0.2em); }

  /* Set in two columns with a rule between them, the way a front page runs
     the top of the lead story before sending you inside. */
  .lead-body {
